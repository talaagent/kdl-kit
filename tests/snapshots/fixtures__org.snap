---
source: tests/fixtures.rs
expression: rewrite(&file)
---
org "acme" {
  display-name "Acme Corp"
  founded 1999
  billing plan="team" seats=25
  member "ada" role="owner" {
    email "ada@acme.example" "ada@lovelace.example"
    tags "math" "engines"
  }
  member "grace" role="admin" {
    email "grace@acme.example"
  }
  member "linus" role="viewer"
  site "eu" {
    region "eu-west-1"
    replicas 3
    domains "acme.eu" "www.acme.eu"
    env "FEATURE_X" "on"
    env "LOG_LEVEL" "info"
  }
  site "us" {
    region "us-east-1"
    replicas 5
    domains "acme.com"
  }
}
